{
  "name": "armoryvault",
  "productName": "ArmoryVault",
  "version": "2.8.0-nightly.8",
  "description": "Firearm & Ammo Inventory Software",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "clean": "rimraf dist dist-electron build node_modules/.vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "check:fix": "biome check --write",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "package:mac": "npm run build && node scripts/build-stable.js --mac",
    "package:win": "npm run build && node scripts/build-stable.js --win",
    "package:linux": "npm run build && node scripts/build-stable.js --linux",
    "package:stable:mac": "npm run build && node scripts/build-stable.js --mac",
    "package:stable:win": "npm run build && node scripts/build-stable.js --win",
    "package:stable:linux": "npm run build && node scripts/build-stable.js --linux",
    "package:nightly:mac": "npm run build && node scripts/build-nightly.js --mac",
    "package:nightly:win": "npm run build && node scripts/build-nightly.js --win",
    "package:nightly:linux": "npm run build && node scripts/build-nightly.js --linux",
    "release": "npm run build && node scripts/build-stable.js --publish always",
    "release:stable": "npm run build && node scripts/build-stable.js --publish always",
    "release:nightly": "npm run build && node scripts/build-nightly.js --publish always",
    "release:prep": "node scripts/prepare-release.js",
    "release:tag": "node scripts/tag-release.js",
    "release:prune": "node scripts/prune-releases.js",
    "release:prune:all": "node scripts/prune-releases.js --all",
    "release:prune:dry": "node scripts/prune-releases.js --all --dry-run",
    "verify:preflight": "node scripts/verify-preflight.js",
    "changelog:draft": "node scripts/generate-changelog-draft.js",
    "clean:fresh": "node scripts/clean-fresh.js",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.armoryvault.app",
    "productName": "ArmoryVault",
    "publish": {
      "provider": "github",
      "owner": "cook0001",
      "repo": "ArmoryVault",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "default",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage"
    }
  },
  "keywords": [],
  "author": "cook0001",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "cors": "^2.8.6",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.33.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/adm-zip": "^0.5.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
